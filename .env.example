FLASK_DEBUG=true
# Defaults to true. Set to false only for local development over plain http.
SESSION_COOKIE_SECURE=false

DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
SECRET_KEY=your_secret_key

MAIL_SERVER=
MAIL_PORT=2525
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=PinIt <noreply@example.com>
MAIL_BACKEND=console